// NACA0020 wing, stage 1: the pre-bent wing released in still fluid (no free stream).
// Values match the IB2d case (fish-ib2d cases/NACA0020_Wing at 9b21eda); see IMPLEMENTATION_DECISIONS.md.
// Top-level `Nx` and `Lx` are also read by Wing_Geom.py (wing_case.read_input2d): keep them plain numbers.

// physical parameters
Lx  = 1.2                    // domain side [m]
MU  = 0.030069               // dynamic viscosity [Pa s], 30x water (IB2d's stable floor)
RHO = 1000.0                 // fluid density [kg/m^3]

// grid
Nx = 192                     // cells per side: dx = 6.25 mm = chord/32
MAX_LEVELS = 1               // uniform grid, no AMR (as IB2d)
REF_RATIO  = 4

// time stepping
DT       = 2.0e-4            // [s], IB2d's stage-3 value
END_TIME = 10.0              // [s], IB2d's run length (full schedule)
VIZ_INTERVAL  = 250          // steps: 0.05 s, IB2d's field_interval
DATA_INTERVAL = 250

// solver
DELTA_FUNCTION      = "IB_4"           // Peskin's 4-point kernel, as IB2d's Supp.give_Delta_Kernel
CONVECTIVE_OP_TYPE  = "CENTERED"       // IB2d: central differences, no upwinding
CONVECTIVE_FORM     = "SKEW_SYMMETRIC" // IB2d: skew-symmetric form
CONVECTIVE_TS_TYPE  = "ADAMS_BASHFORTH"
NUM_CYCLES          = 1
NORMALIZE_PRESSURE  = TRUE
CFL_MAX             = 0.3
ENABLE_LOGGING      = TRUE

IBHierarchyIntegrator {
   start_time          = 0.0
   end_time            = END_TIME
   grow_dt             = 1.0
   num_cycles          = NUM_CYCLES
   regrid_cfl_interval = 0.5
   dt_max              = DT
   error_on_dt_change  = TRUE
   tag_buffer          = 1
   enable_logging      = ENABLE_LOGGING
}

IBMethod {
   delta_fcn      = DELTA_FUNCTION
   enable_logging = ENABLE_LOGGING
}

IBStandardInitializer {
   max_levels      = MAX_LEVELS
   structure_names = "wing"
   wing {
      level_number = MAX_LEVELS - 1
   }
}

INSStaggeredHierarchyIntegrator {
   mu                            = MU
   rho                           = RHO
   start_time                    = 0.0
   end_time                      = END_TIME
   grow_dt                       = 1.0
   convective_time_stepping_type = CONVECTIVE_TS_TYPE
   convective_op_type            = CONVECTIVE_OP_TYPE
   convective_difference_form    = CONVECTIVE_FORM
   normalize_pressure            = NORMALIZE_PRESSURE
   cfl                           = CFL_MAX
   dt_max                        = DT
   using_vorticity_tagging       = FALSE
   tag_buffer                    = 1
   output_U                      = TRUE
   output_P                      = TRUE
   output_F                      = FALSE
   output_Omega                  = TRUE
   output_Div_U                  = TRUE
   enable_logging                = ENABLE_LOGGING
}

Main {
   solver_type                 = "STAGGERED"
   log_file_name               = "wing.log"
   log_all_nodes               = FALSE
   viz_writer                  = "VisIt","Silo"
   viz_dump_interval           = VIZ_INTERVAL
   viz_dump_dirname            = "viz_IB2d"
   visit_number_procs_per_file = 1
   restart_dump_interval       = 0
   restart_dump_dirname        = "restart_IB2d"
   data_dump_interval          = DATA_INTERVAL
   data_dump_dirname           = "hier_data_IB2d"
   timer_dump_interval         = 0
}

CartesianGeometry {
   domain_boxes       = [ (0,0),(Nx - 1,Nx - 1) ]
   x_lo               = 0,0
   x_up               = Lx,Lx
   periodic_dimension = 1,1    // doubly periodic, as IB2d
}

GriddingAlgorithm {
   max_levels = MAX_LEVELS
   ratio_to_coarser {
      level_1 = REF_RATIO,REF_RATIO
   }
   largest_patch_size {
      level_0 = 512,512
   }
   smallest_patch_size {
      level_0 = 8,8
   }
   efficiency_tolerance = 0.85e0
   combine_efficiency   = 0.85e0
}

StandardTagAndInitialize {
   tagging_method = "GRADIENT_DETECTOR"
}

LoadBalancer {
   bin_pack_method     = "SPATIAL"
   max_workload_factor = 1
}

TimerManager {
   print_exclusive = FALSE
   print_total     = TRUE
   print_threshold = 0.1
   timer_list      = "IBAMR::*::*","IBTK::*::*","*::*::*"
}
